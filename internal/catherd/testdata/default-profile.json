{
  "schema": 1,
  "name": "default",
  "objective": "cost",
  "jev": {
    "use": "auto"
  },
  "billing": {
    "codex": "chatgpt-plan",
    "claude": "claude-plan",
    "claude-code": "claude-plan",
    "opencode-go": "subscription",
    "opencode": "metered"
  },
  "roles": {
    "architect": {
      "enabled": true,
      "access": "read-only"
    },
    "verifier": {
      "enabled": true,
      "access": "full"
    },
    "worker": {
      "enabled": true,
      "access": "workspace-write",
      "rungs": [
        "codex:gpt-6-luna#high",
        "codex:gpt-6-sol#medium",
        "codex:gpt-6-sol#high",
        "codex:gpt-6-sol#xhigh"
      ],
      "defaultRung": "codex:gpt-6-sol#medium"
    },
    "reviewer": {
      "enabled": true,
      "access": "read-only",
      "rungs": [
        "codex:gpt-6-sol#high"
      ]
    },
    "ui-reviewer": {
      "enabled": true,
      "access": "full",
      "rungs": [
        "codex:gpt-6-sol#medium"
      ]
    },
    "artist": {
      "enabled": true,
      "access": "workspace-write",
      "rungs": [
        "codex:gpt-6-sol#medium"
      ]
    },
    "writer": {
      "enabled": true,
      "access": "workspace-write",
      "rungs": [
        "codex:gpt-6-luna#high"
      ]
    },
    "researcher": {
      "enabled": true,
      "access": "read-only",
      "rungs": [
        "codex:gpt-6-luna#high"
      ]
    }
  },
  "harness": {
    "codex": {
      "isolated": false
    },
    "claude-code": {
      "isolated": false
    },
    "opencode": {
      "isolated": false
    }
  },
  "failover": {
    "codex:gpt-6-luna#high": "opencode:opencode-go/gpt-6-luna#high",
    "codex:gpt-6-sol#medium": "opencode:opencode-go/kimi-k3#max"
  },
  "budget": {},
  "timeouts": {
    "idleMin": 15,
    "wallMin": 90
  },
  "preflight": {
    "confirm": false
  },
  "lock": {
    "heavy": "cpus/2"
  },
  "notify": [
    "milestone",
    "finish",
    "blocked"
  ]
}
