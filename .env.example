ORQEN_PORT=4280
ORQEN_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=orqen-rs&directConnection=true
ORQEN_DB_NAME=orqen
# ORQEN_DATA_DIR=~/Library/Application Support/Orqen
ORQEN_CREDENTIAL_STORE=keychain
ORQEN_DEV=false
# ORQEN_DEV_ORIGINS=http://localhost:5173
ORQEN_LEASE_TTL_SECS=30
ORQEN_WORKER_CONCURRENCY=4
ORQEN_LOG_FORMAT=pretty
ORQEN_ARTIFACT_MAX_BYTES=67108864
# ORQEN_CATHERD_BIN=~/.bun/bin/catherd
# ORQEN_CATHERD_PATH=/Users/you/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin
# ORQEN_PERSONAL_CATHERD_HOME=   # tests only: the "personal" catherd home that import reads
